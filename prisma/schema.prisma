generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  favorites Favorite[]
  shoppingListItems ShoppingListItem[]
}
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  image       String?

  prepTime    Int?
  cookTime    Int?
  totalTime   Int?
  servings    Int?

  vegetarian    Boolean @default(false)
  vegan         Boolean @default(false)
  glutenFree    Boolean @default(false)
  dairyFree     Boolean @default(false)
  containsAlcohol Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]
  instructions Instruction[]
  nutrition Nutrition?

  categories RecipeCategory[]
  cuisines   RecipeCuisine[]
  diets      RecipeDiet[]
  allergies  RecipeAllergy[]
  mealTypes  RecipeMealType[]
  equipment  RecipeEquipment[]
  favorites Favorite[]
}

model Ingredient {
  id             String   @id @default(cuid())
  name           String   @unique
  normalizedName  String   @unique
  recipes RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeIngredient {
  id String @id @default(cuid())

  recipeId     String
  ingredientId String

  amount     Float?
  unit       String?
  preparation String?
  isOptional Boolean @default(false)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeCategory[]
}

model RecipeCategory {
  recipeId   String
  categoryId String

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
}

model Cuisine {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeCuisine[]
}

model RecipeCuisine {
  recipeId  String
  cuisineId String

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cuisine Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([recipeId, cuisineId])
}

model Diet {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeDiet[]
}

model RecipeDiet {
  recipeId String
  dietId   String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  diet   Diet   @relation(fields: [dietId], references: [id], onDelete: Cascade)

  @@id([recipeId, dietId])
}

model Allergy {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeAllergy[]
}

model RecipeAllergy {
  recipeId  String
  allergyId String

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  allergy Allergy @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@id([recipeId, allergyId])
}

model MealType {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeMealType[]
}

model RecipeMealType {
  recipeId   String
  mealTypeId String

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealType MealType @relation(fields: [mealTypeId], references: [id], onDelete: Cascade)

  @@id([recipeId, mealTypeId])
}

model Equipment {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeEquipment[]
}

model RecipeEquipment {
  recipeId    String
  equipmentId String

  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([recipeId, equipmentId])
}

model Instruction {
  id       String @id @default(cuid())
  recipeId String

  step      Int
  text      String
  section   String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, step])
}

model Nutrition {
  id       String @id @default(cuid())
  recipeId String @unique

  calories Float?
  protein  Float?
  fat      Float?
  carbs    Float?
  fiber    Float?
  sugar    Float?
  sodium   Float?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([recipeId])
}

model ShoppingListItem {
  id           String   @id @default(cuid())
  userId       String
  ingredientId String

  amount    Float?
  unit      String?
  isChecked Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ingredientId])
  @@unique([userId, ingredientId])
}